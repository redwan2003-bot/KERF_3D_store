# ============================================================
# Kerf 3D — Environment Configuration Template
# Copy to .env for local/staging/production deployment.
# NEVER commit real credentials to version control.
# ============================================================

# ── Environment ─────────────────────────────────────────────
CI_ENVIRONMENT = development

# ── Base Application ────────────────────────────────────────
app.baseURL = 'http://localhost:8080'
app.forceGlobalSecureRequests = false
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'k3d_session'
app.sessionExpiration = 7200
app.sessionSavePath = WRITEPATH . 'session'

# ── Database (MySQL 8.x) ────────────────────────────────────
database.default.hostname = localhost
database.default.database = kerf3d
database.default.username = kerf3d_user
database.default.password = CHANGE_ME_SECURE_PASSWORD
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# ── Google Drive Media & Upload Integration ─────────────────
# Path to Google Service Account JSON key (relative or absolute)
GOOGLE_DRIVE_KEY_FILE = 'config/credentials/drive-service-account.json'

# Google Drive folder IDs from the URL: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_ROOT_FOLDER_ID = ''
GOOGLE_DRIVE_PRODUCTS_FOLDER_ID = ''
GOOGLE_DRIVE_UPLOADS_FOLDER_ID = ''
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL = ''

# CDN Image Delivery
GOOGLE_DRIVE_THUMBNAIL_WIDTH = 400

# ── Manual MFS Payment Intake ───────────────────────────────
# Store personal or merchant MFS numbers shown to customers on checkout
BKASH_ACCOUNT_NUMBER = '01XXXXXXXXX'
BKASH_ACCOUNT_TYPE = 'Personal'
NAGAD_ACCOUNT_NUMBER = '01XXXXXXXXX'
NAGAD_ACCOUNT_TYPE = 'Personal'
ROCKET_ACCOUNT_NUMBER = '01XXXXXXXXX'
ROCKET_ACCOUNT_TYPE = 'Personal'

# ── Shipping Rates (BDT) ────────────────────────────────────
SHIPPING_INSIDE_DHAKA_RATE = 70.00
SHIPPING_OUTSIDE_DHAKA_RATE = 130.00

# ── Business Rules ──────────────────────────────────────────
CUSTOM_MODEL_SETUP_FEE = 50.00
CUSTOM_MODEL_MANDATORY_DEPOSIT = 100.00

# ── Email / SMTP (Gmail App Password) ───────────────────────
ADMIN_NOTIFICATION_EMAIL = 'kerf.3d@gmail.com'
EMAIL_FROM_ADDRESS = 'kerf.3d@gmail.com'
email.protocol = smtp
email.SMTPHost = 'smtp.gmail.com'
email.SMTPPort = 587
email.SMTPUser = 'kerf.3d@gmail.com'
email.SMTPPass = ''
email.SMTPCrypto = tls
email.fromEmail = 'kerf.3d@gmail.com'
email.fromName = 'Kerf 3D Studio'
