{
    "name": "kerf3d/store",
    "type": "project",
    "description": "Kerf 3D Studio — Custom CodeIgniter 4 Ecommerce & On-Demand Additive Manufacturing Application",
    "homepage": "https://kerf3d.store",
    "license": "proprietary",
    "require": {
        "php": "^8.2 || ^8.3",
        "codeigniter4/framework": "^4.5",
        "google/apiclient": "^2.16"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@composer dump-autoload"
        ]
    },
    "extra": {
        "google/apiclient-services": [
            "Drive"
        ]
    },
    "config": {
        "process-timeout": 1200,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
